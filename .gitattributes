# Text is LF on every checkout (the release fingerprint must not depend on the OS); *.ps1 stays CRLF.
* text=auto eol=lf
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.woff2 binary
*.png binary
*.gif binary
*.toml text eol=lf
*.yml text eol=lf
